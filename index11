<div class="overlay" id="modal"><div class="modal"><h2 id="modalTitle">Create a Note</h2><p id="modalDescription">Capture an idea, class note, or reminder.</p><input id="modalInput" placeholder="Write down something to remember…"><div class="modal-actions"><button class="secondary" id="cancel">Cancel</button><button class="primary" id="save">Save note</button></div></div></div><div class="searchbox" id="searchBox"><input id="searchInput" placeholder="Search this workbench… (Esc to close)"></div><div class="toast" id="toast"></div>
<script>
const $=selector=>document.querySelector(selector),toast=$('#toast'),modal=$('#modal');let toastTimer,modalMode='note';
function showToast(message){toast.textContent=message;toast.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>toast.classList.remove('show'),2300)}
function openModal(mode){modalMode=mode;$('#modalTitle').textContent=mode==='task'?'Add a Task':'Create a Note';$('#modalDescription').textContent=mode==='task'?'Add a task to Today’s Plan.':'Capture an idea, class note, or reminder.';$('#modalInput').placeholder=mode==='task'?'What do you need to do?':'Write down something to remember…';$('#modalInput').value='';$('#save').textContent=mode==='task'?'Add task':'Save note';modal.classList.add('show');$('#modalInput').focus()}
function closeModal(){modal.classList.remove('show')}
const now=new Date(),weekdays=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];$('#dateText').textContent=`${weekdays[now.getDay()]}, ${now.toLocaleString('en-US',{month:'long'})} ${now.getDate()}`;
const CHECKS_KEY='thuan-workbench-checks-v1',NOTES_KEY='thuan-workbench-notes-v1',TASKS_KEY='thuan-workbench-tasks-v1',GOALS_KEY='thuan-workbench-goals-v1';
function readStore(key,fallback){try{return JSON.parse(localStorage.getItem(key)||JSON.stringify(fallback))}catch{return fallback}}
let checks=readStore(CHECKS_KEY,{}),notes=readStore(NOTES_KEY,[]),goals=readStore(GOALS_KEY,[]);
const defaultTasks=[{id:'daily-1',text:'Go to school'},{id:'daily-2',text:'Do exercise'},{id:'daily-3',text:'Do housework'},{id:'daily-4',text:''},{id:'daily-5',text:''},{id:'daily-6',text:''},{id:'daily-7',text:''},{id:'daily-8',text:''}];
let tasks=readStore(TASKS_KEY,defaultTasks);if(!Array.isArray(tasks)||tasks.length!==8)tasks=defaultTasks;
function updateTaskProgress(){const count=tasks.filter(task=>task.text&&checks[task.id]).length;$('#dailyTaskCount').textContent=`${count}/8`;$('#dailyTaskProgress').style.width=`${count/8*100}%`}
function wireCheck(button,key){button.dataset.checkId=key;button.setAttribute('aria-pressed',String(Boolean(checks[key])));button.addEventListener('click',()=>{checks[key]=button.getAttribute('aria-pressed')!=='true';button.setAttribute('aria-pressed',String(checks[key]));localStorage.setItem(CHECKS_KEY,JSON.stringify(checks));updateTaskProgress();showToast(checks[key]?'Task completed.':'Task unchecked.')})}
function renderTasks(){const list=$('#taskList');list.replaceChildren();tasks.forEach((task,index)=>{const item=document.createElement('li'),check=document.createElement('button');check.className='check';check.setAttribute('aria-label',`Mark ${task.text||`task ${index+1}`} complete`);check.disabled=!task.text;item.append(check);wireCheck(check,task.id);if(task.text){const label=document.createElement('span');label.textContent=task.text;item.append(label)}else{const input=document.createElement('input');input.className='task-entry';input.placeholder='Add a task…';input.setAttribute('aria-label',`Enter task ${index+1}`);input.value='';input.addEventListener('change',()=>{const value=input.value.trim();if(!value)return;tasks[index].text=value;localStorage.setItem(TASKS_KEY,JSON.stringify(tasks));renderTasks();updateTaskProgress();showToast('Task added to Today’s Plan.')});input.addEventListener('keydown',event=>{if(event.key==='Enter'){event.preventDefault();input.blur()}});item.append(input)}});updateTaskProgress()}
renderTasks();
function addTask(text){const value=text.trim();if(!value)return;const slot=tasks.findIndex(task=>!task.text);if(slot<0){showToast('All 8 daily task slots are filled.');closeModal();return}tasks[slot].text=value;localStorage.setItem(TASKS_KEY,JSON.stringify(tasks));renderTasks();$('#modalInput').value='';closeModal();showToast('Task added to Today’s Plan.')}
function renderNotes(){const host=$('#recentNote');host.replaceChildren();if(!notes.length){host.textContent='Your captured notes will appear here.';return}const list=document.createElement('ul');list.className='saved-notes';notes.forEach(note=>{const item=document.createElement('li');item.textContent=note;list.append(item)});host.append(list)}
function saveNote(text){const value=text.trim();if(!value)return;notes.unshift(value);notes=notes.slice(0,20);localStorage.setItem(NOTES_KEY,JSON.stringify(notes));renderNotes();const card=document.querySelector('#capture .list-card:last-child');if(card){const row=document.createElement('div');row.className='list-item';const title=document.createElement('span'),stamp=document.createElement('span');title.textContent=value;stamp.textContent='Just now';row.append(title,stamp);card.append(row)}$('#quickInput').value='';$('#modalInput').value='';closeModal();showToast('Note saved.')}
function renderGoals(){const list=$('#goalList');list.replaceChildren();goals.forEach(goal=>{const item=document.createElement('li');item.textContent=goal;list.append(item)});$('#goalCount').textContent=`${goals.length} goals`;$('#goalProgress').style.width=`${Math.min(goals.length/5*100,100)}%`}
$('#goalForm').addEventListener('submit',event=>{event.preventDefault();const value=$('#goalInput').value.trim();if(!value)return;goals.push(value);localStorage.setItem(GOALS_KEY,JSON.stringify(goals));$('#goalInput').value='';renderGoals();showToast('Personal goal added.')});
renderGoals();renderNotes();
$('#quickForm').addEventListener('submit',event=>{event.preventDefault();const value=$('#quickInput').value.trim();if(value)saveNote(value);else openModal('note')});
$('#cancel').addEventListener('click',closeModal);$('#save').addEventListener('click',()=>{const value=$('#modalInput').value.trim();if(!value){showToast(modalMode==='task'?'Enter a task first.':'Write a note first.');return}if(modalMode==='task')addTask(value);else saveNote(value)});modal.addEventListener('click',event=>{if(event.target===modal)closeModal()});$('#notice').addEventListener('click',()=>showToast('You have no new alerts.'));
document.querySelectorAll('[data-action]').forEach(button=>button.addEventListener('click',()=>{const action=button.dataset.action;if(action==='task'){openModal('task')}else if(action==='note'){openModal('note')}else if(action==='plan'){document.querySelector('#todays-plan').scrollIntoView({behavior:'smooth'});openModal('task')}else if(action==='review'){showToast('Weekly Review: reflect on wins, improvements, and next week.')}}));
const searchBox=$('#searchBox'),searchInput=$('#searchInput');$('#searchToggle').addEventListener('click',()=>{searchBox.classList.toggle('show');if(searchBox.classList.contains('show'))searchInput.focus()});searchInput.addEventListener('input',()=>{document.querySelectorAll('.search-mark').forEach(element=>element.classList.remove('search-mark'));const query=searchInput.value.trim().toLowerCase();if(query)document.querySelectorAll('main .section,main .hero,main .quick').forEach(element=>{if(element.textContent.toLowerCase().includes(query))element.classList.add('search-mark')})});
document.addEventListener('keydown',event=>{if(event.key==='Escape'){searchBox.classList.remove('show');closeModal()}});document.querySelectorAll('.nav a').forEach(link=>link.addEventListener('click',()=>{document.querySelectorAll('.nav a').forEach(item=>item.classList.remove('active'));link.classList.add('active')}));
</script></body></html>















